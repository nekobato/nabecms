{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nabecms-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true,
    },
  },
  // Admin Web static files built from repository sources.
  "assets": {
    "directory": "../nabecms-admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "ratelimits": [
    {
      "name": "AUTH_LOGIN_RATE_LIMITER",
      "namespace_id": "12001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "AUTH_SENSITIVE_RATE_LIMITER",
      "namespace_id": "12002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "triggers": { "crons": ["0 18 * * *"] },
  "vars": {
    "WORKER_ENV": "development",
    "ADMIN_DEV_PROXY": "true",
    "ADMIN_DEV_PORT": "2525",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nabecms",
      "database_id": "[DATABASE_ID]",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "nabecms-media",
    },
  ],
}
