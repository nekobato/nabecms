{
  "name": "__PACKAGE_NAME__",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm nabecms:migrate --remote --env production && wrangler deploy --minify --env production",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && pnpm nabecms:bundle-migrations",
    "db:migrate:local": "pnpm nabecms:migrate --local",
    "db:migrate:remote": "pnpm nabecms:migrate --remote --env production",
    "db:reset:local": "rm -rf .wrangler/state && pnpm nabecms:migrate --local",
    "typecheck": "wrangler types && tsc -p tsconfig.json --noEmit",
    "nabecms:doctor": "nabecms doctor",
    "nabecms:migrate": "nabecms migrate",
    "nabecms:bundle-migrations": "nabecms bundle-migrations"
  },
  "dependencies": {
    "@nekobato/nabecms": "__NABECMS_VERSION__"
  },
  "devDependencies": {
    "@nekobato/nabecms-cli": "__NABECMS_CLI_VERSION__",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "wrangler": "4.156.1"
  },
  "engines": {
    "node": "^24.22.3 || ^26.13.1",
    "pnpm": ">=11"
  }
}
