{
  "name": "@nekobato/nabecms-admin",
  "version": "0.1.0-alpha.1",
  "description": "Prebuilt NabeCMS Admin UI assets for Cloudflare Workers.",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekobato/nabecms.git",
    "directory": "packages/nabecms-admin"
  },
  "bugs": {
    "url": "https://github.com/nekobato/nabecms/issues"
  },
  "homepage": "https://github.com/nekobato/nabecms#readme",
  "engines": {
    "node": "^24.22.1 || ^26.12.1",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/admin-third-party-notices.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "node ./e2e/run-product-e2e.mjs",
    "build-only": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --fix && pnpm typecheck",
    "lint:ci": "eslint .",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.3",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@iconify/vue": "5.0.4",
    "@nekobato/nabecms-core": "workspace:*",
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-drag-handle": "3.32.1",
    "@tiptap/extension-link": "3.32.1",
    "@tiptap/extension-placeholder": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@tiptap/vue-3": "3.32.1",
    "@tiptap/y-tiptap": "3.0.11",
    "@types/markdown-it": "14.2.0",
    "@vee-validate/i18n": "4.15.1",
    "@vee-validate/rules": "4.15.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "element-plus": "2.14.7",
    "markdown-it": "15.0.3",
    "pinia": "4.1.0",
    "vee-validate": "4.15.1",
    "vue": "3.5.44",
    "vue-codemirror": "6.1.1",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-vue": "10.12.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sass-embedded": "1.107.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
